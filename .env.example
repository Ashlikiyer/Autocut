# Copy to .env.local and fill in.

# Groq (https://console.groq.com/keys). Server only, never NEXT_PUBLIC_.
GROQ_API_KEY=

# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string, e.g. `openssl rand -hex 32`. Server only.
IP_HASH_SALT=

# Free videos per day for each browser (counted with an anonymous cookie).
ANON_DAILY_LIMIT=3

# Free videos per day for one internet connection (IP) across all its browsers,
# so clearing cookies doesn't give unlimited videos. Shared Wi-Fi and mobile
# carriers put many people behind one IP, so keep this well above ANON_DAILY_LIMIT.
ANON_IP_DAILY_LIMIT=30

# Optional: Groq model for the AI director (default openai/gpt-oss-120b).
# GROQ_PLAN_MODEL=

# Optional: Groq vision model that looks at snapshots in auto mode (default qwen/qwen3.8-27b).
# GROQ_VISION_MODEL=

# Optional: HyperFrames overlay server (render-server/) for animated cards.
# NEXT_PUBLIC_OVERLAY_URL=http://localhost:4100
